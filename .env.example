# Copy to .env and fill in your own values. Never commit .env.
# Backend API base URL (e.g. your deployed Render URL).
# Restart `npx expo start` after changing this so Expo picks it up.
# Tip: on an Android emulator use http://10.0.2.2:5000 for a backend
# running on your own machine (127.0.0.1 would be the emulator itself).
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
